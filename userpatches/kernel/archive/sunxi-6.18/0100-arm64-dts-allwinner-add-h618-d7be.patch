arm64: dts: allwinner: add H618 D7BE TV box

Add devicetree for the Allwinner H618 based D7BE_H618_V1.2 TV box:
4GB RAM, 128GB eMMC, gigabit ethernet, HDMI, IR, USB-A x2, no WiFi.
No PMIC node is referenced since the board's PMIC is unknown; all
rails are modelled as fixed regulators.

Signed-off-by: h618-armbian <noreply@example.com>

--- /dev/null
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h618-d7be.dts
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Allwinner H618 TV box, board D7BE_H618_V1.2 (2024-01-30)
+ *
+ * 硬件实测：H618 / 4GB RAM / 128GB eMMC / 千兆网口 / 无无线模块
+ *          USB-C 供电 / RJ45 / HDMI / AV / USB-A x2 / TF / 红外
+ *
+ * 说明：
+ *  - 本板 PMIC 型号未知，故不引用任何 PMIC 节点，全部用 fixed regulator，
+ *    避免因 PMIC 不匹配导致 regulator 解析失败而卡住启动。
+ *    代价：CPU/GPU 无 DVFS，定频运行。
+ *  - 千兆网口走 emac0 + RGMII（与 Orange Pi Zero3 同款方案）。
+ *    PHY 型号未知，用通用 ieee802.3-c22 由 phylib 按 ID 自动匹配；
+ *    PHY 地址暂按 1（全志参考设计常用值），若不通再试 0。
+ *  - 调试串口按全志参考设计为 UART0 (PH0/PH1) 115200 8N1。
+ *  - HDMI 依赖 Armbian 补丁 0038~0042 提供的 DE33/TCON/HDMI 支持。
+ */
+
+/dts-v1/;
+
+#include "sun50i-h616.dtsi"
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/leds/common.h>
+
+/ {
+	model = "H618 D7BE TV Box";
+	compatible = "d7be,h618-d7be", "allwinner,sun50i-h618";
+
+	aliases {
+		ethernet0 = &emac0;
+		mmc0 = &mmc0;
+		mmc2 = &mmc2;
+		serial0 = &uart0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
+	reg_vcc5v: regulator-vcc5v {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+
+	reg_vcc3v3: regulator-vcc3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&reg_vcc5v>;
+		regulator-always-on;
+	};
+
+	reg_vcc1v8: regulator-vcc1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&reg_vcc3v3>;
+		regulator-always-on;
+	};
+
+	reg_usb1_vbus: regulator-usb1-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&reg_vcc5v>;
+		regulator-always-on;
+	};
+};
+
+&de {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&hdmi {
+	hvcc-supply = <&reg_vcc1v8>;
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
+
+&emac0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&ext_rgmii_pins>;
+	phy-mode = "rgmii-rxid";
+	phy-handle = <&ext_rgmii_phy>;
+	allwinner,tx-delay-ps = <700>;
+	phy-supply = <&reg_vcc3v3>;
+	status = "okay";
+};
+
+&mdio0 {
+	ext_rgmii_phy: ethernet-phy@1 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <1>;
+	};
+};
+
+&mmc0 {
+	vmmc-supply = <&reg_vcc3v3>;
+	bus-width = <4>;
+	broken-cd;
+	status = "okay";
+};
+
+&mmc2 {
+	vmmc-supply = <&reg_vcc3v3>;
+	bus-width = <8>;
+	non-removable;
+	status = "okay";
+};
+
+&ehci1 {
+	status = "okay";
+};
+
+&ohci1 {
+	status = "okay";
+};
+
+&usbotg {
+	dr_mode = "otg";
+	status = "okay";
+};
+
+&usbphy {
+	usb1_vbus-supply = <&reg_usb1_vbus>;
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_ph_pins>;
+	status = "okay";
+};
+
+&ir {
+	status = "okay";
+};
